{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "akaunting/setting": "^1.2.7",
        "bacon/bacon-qr-code": "^2.0",
        "barryvdh/laravel-dompdf": "^2.0",
        "cboden/ratchet": "^0.4.4",
        "cviebrock/eloquent-sluggable": "^8.0",
        "doctrine/dbal": "^3.1",
        "emotality/tawk-laravel": "^2.1",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "haruncpi/laravel-log-reader": "^1.0",
        "laravel/framework": "^8.83.1",
        "laravel/socialite": "^5.16",
        "laravel/telescope": "^5.11",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^3.1",
        "laravelcollective/html": "^6.4",
        "maatwebsite/excel": "^3.1",
        "octopyid/laravel-impersonate": "^2",
        "pragmarx/countries": "^0.7.2",
        "pragmarx/google2fa-laravel": "^2.0",
        "pusher/pusher-php-server": "^7.2",
        "radicalloop/eodhistoricaldata": "^5.0",
        "ratchet/pawl": "^0.4.3",
        "santigarcor/laratrust": "^6.3",
        "snowfire/beautymail": "^1.1",
        "spatie/laravel-permission": "^6.10",
        "stephenjude/default-model-sorting": "^1.2",
        "textalk/websocket": "^1.5",
        "tijsverkoyen/css-to-inline-styles": "*",
        "tymon/jwt-auth": "^1.0",
        "watson/active": "^6.0",
        "yadahan/laravel-authentication-log": "^1.3"
    },
    "require-dev": {
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "knuckleswtf/scribe": "^3.11",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helper/Helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
